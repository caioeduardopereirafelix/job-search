# Copie para .env e preencha. O .env nao e versionado.
DB_URL=jdbc:postgresql://localhost:5432/jobmatch
DB_USER=postgres
DB_PASSWORD=troque-esta-senha

# Credenciais em https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Segredo para assinar o JWT (use uma string longa e aleatoria)
JWT_SECRET=

# Opcional (padrao: ./uploads/resumes)
# RESUME_STORAGE_PATH=./uploads/resumes
